{
  "name": "@depgate/unpm",
  "version": "0.1.0",
  "description": "An npm wrapper that delegates to pnpm for improved security",
  "repository": {
    "type": "git",
    "url": "https://github.com/depgate/unpm"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "unpm": "./bin/unpm.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "npm",
    "pnpm",
    "security",
    "wrapper",
    "cli"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^9.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "peerDependencies": {
    "@lavamoat/allow-scripts": "^3.2.1"
  },
  "peerDependenciesMeta": {
    "@lavamoat/allow-scripts": {
      "optional": true
    }
  }
}
